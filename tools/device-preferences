#!/usr/bin/env python3
"""Reversible SRD banner and unlimited Everyone AirDrop preferences for the tested iPad."""
import argparse, datetime, os, pathlib, plistlib, shlex, subprocess
ROOT=pathlib.Path(__file__).resolve().parents[1]
MG='/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist'
AD='/var/Managed Preferences/mobile/com.apple.sharingd.plist'
KEY='XYlJKKkj2hztRP1NWWnhlw'
def ssh(cmd,data=None):
 return subprocess.run([str(ROOT/'tools/sshdev'),cmd],input=data,stdout=subprocess.PIPE,check=True).stdout
def load(path):
 raw=ssh('if test -f '+shlex.quote(path)+'; then cat '+shlex.quote(path)+'; fi')
 return plistlib.loads(raw) if raw else {}
def write(path,value,owner,mode):
 tmp=path+'.liter8-new'
 ssh('cat > '+shlex.quote(tmp),plistlib.dumps(value,fmt=plistlib.FMT_BINARY))
 ssh(f'chown {owner} {shlex.quote(tmp)} && chmod {mode} {shlex.quote(tmp)} && mv {shlex.quote(tmp)} {shlex.quote(path)}')
def helper():
 sdk=os.environ.get('LITER8_IOS_SDK',str(pathlib.Path.home()/'theos/sdks/iPhoneOS16.5.sdk'))
 dst=ROOT/'device/deviceprefs/prefs'
 subprocess.run(['xcrun','clang','-isysroot',sdk,'-arch','arm64','-arch','arm64e','-miphoneos-version-min=15.0','-framework','Foundation',str(dst.with_suffix('.m')),'-o',str(dst)],check=True)
 subprocess.run([str(ROOT/'tools/ldid_macosx_arm64'),'-S'+str(ROOT/'device/deviceprefs/entitlements.plist'),'-Cadhoc',str(dst)],check=True)
 ssh('cat > /var/tmp/l8-deviceprefs',dst.read_bytes()); ssh('chmod 755 /var/tmp/l8-deviceprefs')
p=argparse.ArgumentParser(description=__doc__); p.add_argument('action',choices=['apply','status']); a=p.parse_args()
if ssh('sysctl -n hw.machine').strip()!=b'iPad11,6' or ssh('sysctl -n kern.osversion').strip()!=b'23H30':
 raise SystemExit('Unsupported device/build; no changes made')
if a.action=='apply':
 backup='/var/jb/var/backups/deviceprefs-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
 ssh('mkdir -p '+shlex.quote(backup)+' '+shlex.quote(str(pathlib.PurePosixPath(AD).parent)))
 for path,name in [(MG,'MobileGestalt.plist'),(AD,'managed-sharingd.plist'),('/var/mobile/Library/Preferences/com.apple.sharingd.plist','sharingd.plist')]:
  ssh('if test -f '+shlex.quote(path)+'; then cp -p '+shlex.quote(path)+' '+shlex.quote(backup+'/'+name)+'; else touch '+shlex.quote(backup+'/'+name+'.absent')+'; fi')
 gestalt=load(MG)
 if not isinstance(gestalt.get('CacheExtra'),dict): raise SystemExit('Invalid MobileGestalt cache')
 helper()
 gestalt['CacheExtra'][KEY]=1
 ssh('cat > /var/tmp/l8-mobilegestalt-new.plist',plistlib.dumps(gestalt,fmt=plistlib.FMT_BINARY))
 ssh('/var/tmp/l8-deviceprefs mg-write && rm /var/tmp/l8-mobilegestalt-new.plist')
 sharing=load(AD); sharing['OverrideTimeLimitEveryoneMode']=True; write(AD,sharing,'501:501','644')
 ssh('/var/tmp/l8-deviceprefs airdrop')
 ssh('killall sharingd 2>/dev/null || true')
 print('Backup:',backup)
 print('SRD flag saved; existing UI may retain its cached value until a later SpringBoard restart.')
print('SRD cache:',load(MG).get('CacheExtra',{}).get(KEY))
print('AirDrop timeout override:',load(AD).get('OverrideTimeLimitEveryoneMode'))
print('AirDrop mode:',load('/var/mobile/Library/Preferences/com.apple.sharingd.plist').get('DiscoverableMode'))
