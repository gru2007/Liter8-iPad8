#!/usr/bin/env python3
"""Repair TrollDecrypt's launch signature on the verified TASKAC2 kernel."""
import datetime
import hashlib
import os
from pathlib import Path
import plistlib
import re
import shlex
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent

def run(args, **kwargs):
    return subprocess.run(args, check=True, stdout=subprocess.PIPE, **kwargs).stdout

def ssh(command, data=None):
    return run([str(ROOT / 'tools/sshdev'), command], input=data)

def entitlements(path):
    raw = run([str(ROOT / 'tools/ldid_macosx_arm64'), '-e', str(path)])
    parts = [plistlib.loads(b'<?xml' + part) for part in raw.split(b'<?xml')[1:]]
    if not parts or any(part != parts[0] for part in parts):
        raise RuntimeError('Missing or differing slice entitlements; refusing replacement')
    return parts[0]

if 'TASKAC2_ARM64_T8020' not in ssh('uname -v').decode():
    raise SystemExit('Requires the hardware-verified TASKAC2 kernel; no change made')
paths = ssh("find /var/containers/Bundle/Application -path '*/TrollDecrypt.app/TrollDecrypt' -type f").decode().splitlines()
if len(paths) != 1:
    raise SystemExit('Expected exactly one installed TrollDecrypt')
path = paths[0]
match = re.fullmatch(r'/var/containers/Bundle/Application/([0-9a-fA-F-]{36})/TrollDecrypt.app/TrollDecrypt', path)
if not match:
    raise SystemExit('Unexpected app path')
info = plistlib.loads(ssh('cat ' + shlex.quote(str(Path(path).parent / 'Info.plist'))))
if info.get('CFBundleIdentifier') != 'com.fiore.trolldecrypt':
    raise SystemExit('Unexpected bundle identifier')
with tempfile.TemporaryDirectory(prefix='liter8-trolldecrypt-') as work:
    work = Path(work)
    original = work / 'original'
    original.write_bytes(ssh('cat ' + shlex.quote(path)))
    expected = entitlements(original)
    if 'task_for_pid-allow' not in expected:
        print('Blocking entitlement is already absent; no change made')
        raise SystemExit(0)
    backup = ROOT / '.liter8-trolldecrypt-backups' / datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    backup.mkdir(parents=True)
    shutil.copy2(original, backup / 'TrollDecrypt.original')
    (backup / 'device-path.txt').write_text(path + '\n')
    expected.pop('task_for_pid-allow')
    ent = work / 'app.entitlements'
    ent.write_bytes(plistlib.dumps(expected))
    replacement = work / 'replacement'
    shutil.copy2(original, replacement)
    ldid = str(ROOT / 'tools/ldid_macosx_arm64')
    run([ldid, '-S' + str(ent), '-Cadhoc', str(replacement)])
    if entitlements(replacement) != expected:
        raise RuntimeError('Entitlement verification failed')
    sdk = os.environ.get('LITER8_IOS_SDK', str(Path.home() / 'theos/sdks/iPhoneOS16.5.sdk'))
    helper = work / 'writer'
    run(['xcrun', 'clang', '-arch', 'arm64', '-isysroot', sdk, '-miphoneos-version-min=15.0',
         str(ROOT / 'device/trolldecryptfix/replace.c'), '-o', str(helper)])
    run([ldid, '-S' + str(ROOT / 'device/trolldecryptfix/writer.entitlements'), '-Cadhoc', str(helper)])
    ssh('cat > /var/tmp/l8-trollwrite && chmod 700 /var/tmp/l8-trollwrite', helper.read_bytes())
    ssh('cat > /var/tmp/l8-TrollDecrypt.launch', replacement.read_bytes())
    # Ensure the executable has not changed since the backup was made.
    if ssh('cat ' + shlex.quote(path)) != original.read_bytes():
        raise RuntimeError('App changed during preparation; no replacement made')
    ssh('/var/tmp/l8-trollwrite ' + shlex.quote(match[1]))
    actual = ssh('cat ' + shlex.quote(path))
    if hashlib.sha256(actual).digest() != hashlib.sha256(replacement.read_bytes()).digest():
        raise RuntimeError('Installed executable readback mismatch')
    ssh('rm -f /var/tmp/l8-trollwrite /var/tmp/l8-TrollDecrypt.launch')
    print('Signature repaired and verified. Close and reopen TrollDecrypt.')
    print('Original backup:', backup)
