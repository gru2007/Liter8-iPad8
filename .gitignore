/device/deviceprefs/prefs

/device/appfix/icleaner-launch
/device/appfix/newterm-login

/device/rootappfix/l8rootapps.dylib
/device/appfix/newterm-helper
/device/taskprobe/taskprobe
/device/taskprobe/l8selfdump.dylib
/device/launchdhook/lhookctl
